  "observations": [
    {
      "appearance": "cc-thin-stem",
      "validationExamples": [
        "chesscom-img_5401",
        "chesscom-img_5402"
      ],
      "finding": "No matching umbrella-shaped thin-stem pawn and king design identified in representative training crops. Other slender designs exist; they are not assumed equivalent. Prioritize real training examples of this appearance."
    },
    {
      "appearance": "cc-shaded",
      "validationExamples": [
        "chesscom-img_5397",
        "chesscom-img_5398"
      ],
      "trainingExamples": [
        "chesscom-photo-46",
        "chesscom-photo-47",
        "chesscom-photo-48",
        "chesscom-photo-49",
        "chesscom-photo-50",
        "chesscom-photo-51",
        "chesscom-photo-52",
        "chesscom-photo-53",
        "chesscom-photo-54",
        "chesscom-photo-55"
      ],
      "finding": "Similar shaded pieces are present in ten training photographs, mostly over plain brown/blue backgrounds. Validation wood texture remains a coverage gap; absence of the piece style alone does not explain errors."
    },
    {
      "appearance": "lc-rounded-king",
      "validationExamples": [
        "lichess-img_5391",
        "lichess-img_5392"
      ],
      "finding": "Related rounded king designs exist in Lichess/video training crops. Exact design, background and photographic degradation remain confounded; do not claim the entire family is absent."
    },
    {
      "category": "chesscom",
      "finding": "Forty of 55 direct-platform training photos use a conventional appearance; five a flatter appearance and ten a shaded appearance. Photo count overstates design diversity."
    }
  ],
